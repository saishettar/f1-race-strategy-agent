# Copy this file to .env (same directory) and fill in your key to enable
# the real Claude tool-use agent. Without it, the app runs fully on the
# rule-based agent — no key required for the rest of the app to work.
ANTHROPIC_API_KEY=

# Optional: override the model used for the live agent.
# ANTHROPIC_MODEL=claude-sonnet-5

# Distinguishes this app's traces from other iris_otel-instrumented apps in
# the Iris dashboard (defaults to the generic "iris-instrumented-app" if unset).
IRIS_SERVICE_NAME=undercut
